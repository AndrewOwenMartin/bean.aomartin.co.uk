{
    "compilerOptions": {
        "baseUrl": ".",
        "checkJs": false,
        "experimentalDecorators": false,
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "sourceMap": true,
        "strict": true,
        "strictFunctionTypes": true,
        "strictNullChecks": true,
        "target": "ES2024"
    },
    "exclude": [
        "node_modules",
        "**/node_modules/*"
    ]
}